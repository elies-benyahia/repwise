# Copier en .env et adapter. Valeurs par défaut = MySQL de Laragon en local.
PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=repwise

# En production derrière Vercel + l'hébergeur de l'API : nombre de proxys devant le serveur.
TRUST_PROXY=0

# URL publique du frontend, utilisée pour construire le lien dans l'email de réinitialisation
# de mot de passe (auth/routes.js). En production : https://tondomaine.fr
URL_FRONTEND=http://localhost:5173

# Email transactionnel (réinitialisation de mot de passe) via l'API REST de Resend
# (https://resend.com, offre gratuite). Sans RESEND_API_KEY : le lien est juste affiché dans les
# logs serveur au lieu d'être envoyé (utile en dev, insuffisant en production).
RESEND_API_KEY=
EMAIL_EXPEDITEUR=Repwise <onboarding@resend.dev>
